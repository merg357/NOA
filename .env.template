GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_ANDROID_DEBUG_CLIENT_ID=""

# ── Google Play tester automation (scripts/google_play_tester_setup.py) ───────
# Check setup with:
#   .venv/bin/python scripts/google_play_tester_setup.py --doctor
# Path to GCP service account JSON key with domain-wide delegation enabled.
# The service account must have:
#   - Admin SDK API scope in Google Workspace Admin > Security > Domain-wide delegation
#     scopes:
#       https://www.googleapis.com/auth/admin.directory.user
#       https://www.googleapis.com/auth/admin.directory.group
#       https://www.googleapis.com/auth/admin.directory.group.member
#   - "Release manager" role in Google Play Console > Setup > API access
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service_account.json
# A Google Workspace super-admin email used to impersonate for user management.
GOOGLE_ADMIN_EMAIL=admin@yourdomain.com
# Domain for tester accounts (e.g. yourdomain.com → tester01@yourdomain.com)
TESTER_DOMAIN=yourdomain.com
# Number of tester accounts to create. Google Play closed testing needs 12;
# 15 gives a small buffer if someone fails to opt in for all 14 days.
TESTER_COUNT=15
# Google Group used by the Play Developer API. The API accepts Google Groups,
# not individual tester emails.
# If you do not have Google Workspace, create a Google Group manually and use
# --skip-workspace, or use scripts/google_play_email_list_csv.py for the Play
# Console email-list upload fallback.
TESTER_GROUP_EMAIL=play-testers@yourdomain.com
# Optional Workspace OU where tester users are created.
TESTER_OU_PATH=/Testers
# Create the tester group when missing.
TESTER_CREATE_GROUP=true
# Android app package name registered in Google Play Console
PLAY_PACKAGE_NAME=xyz.brilliant.noaflutter
# Google Play track to add the tester group to: alpha | beta | internal
# Use alpha/beta for closed testing. Internal testing is fast QA only and does
# not satisfy the 12-tester/14-day production-access requirement.
PLAY_TRACK=alpha

# ── OpenAI credentials ────────────────────────────────────────────────────────
# Required when STT_PROVIDER=openai, TTS_PROVIDER=openai, or
# ASSISTANT_PROVIDER=openai.  Leave empty to run in mock mode (no key needed).
OPENAI_API_KEY=

# ── Voice loop configuration ──────────────────────────────────────────────────
# Set ENABLE_STT=true to show the mic button in the chat UI.
ENABLE_STT=true
# Set ENABLE_TTS=true to play TTS audio after each assistant reply.
ENABLE_TTS=false
# STT_PROVIDER: "mock" (no API key) | "openai" (Whisper — requires OPENAI_API_KEY)
STT_PROVIDER=mock
# TTS_PROVIDER: "mock" (silent) | "openai" (TTS-1 — requires OPENAI_API_KEY)
TTS_PROVIDER=mock
# Voice name passed to OpenAI TTS when TTS_PROVIDER=openai.
# Options: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=onyx
# ASSISTANT_PERSONA: calm_executive | concise | friendly
ASSISTANT_PERSONA=calm_executive
# VOICE_MOCK_MODE=true keeps all voice providers in mock/demo mode even when
# keys are present.  Set to false to activate real backends.
VOICE_MOCK_MODE=true

# ── Assistant backend ─────────────────────────────────────────────────────────
# ASSISTANT_PROVIDER: "mock" (mode-aware canned replies) | "openai" (Chat Completions)
# When set to "openai", OPENAI_API_KEY must be non-empty and VOICE_MOCK_MODE=false.
ASSISTANT_PROVIDER=mock
# OpenAI model for assistant replies (only used when ASSISTANT_PROVIDER=openai).
# gpt-4o-mini is fast and cheap; upgrade to gpt-4o for higher quality.
OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# ── Desktop launcher flags (Windows PC) ──────────────────────────────────────
# These can also be set as OS environment variables (ARIA_KIOSK, etc.)
# or passed as --dart-define at build time (see scripts/windows/).
#
# Launch full-screen with no window chrome (kiosk mode).
DESKTOP_KIOSK=false
# Reserved: auto-connect to the nearest paired Frame device on launch.
DESKTOP_AUTO_CONNECT=false
# Activate the microphone immediately when the chat screen opens.
DESKTOP_START_VOICE_READY=false

# ── Gemini Live ───────────────────────────────────────────────────────────────
# Enable the Gemini Live real-time audio path (replaces STT → assistant → TTS).
# When true, a single mic tap opens a persistent WebSocket session with Gemini.
GEMINI_LIVE_ENABLED=false

# Google AI Studio API key.  Required when GEMINI_LIVE_ENABLED=true and you are
# NOT using an ephemeral token server.
# ⚠  Never commit this key.  The .env file is listed in .gitignore.
# Production deployments should use GEMINI_LIVE_EPHEMERAL_TOKEN_URL instead.
GEMINI_API_KEY=

# Gemini Live model.  As of May 2025 the live-capable model is:
#   models/gemini-2.0-flash-live-001
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-live-001

# Pre-built voice for Gemini's audio output.
# Options (May 2025): Puck · Aoede · Charon · Fenrir · Kore
GEMINI_LIVE_VOICE=Puck

# (Optional) URL of a server endpoint that returns a short-lived ephemeral token.
# When set, the app POSTs to this URL and uses the returned {"token":"..."} for
# the WebSocket connection instead of GEMINI_API_KEY.  Leave blank for dev.
# Production: set to https://<your-vps-ip>:8765/gemini/ephemeral-token
GEMINI_LIVE_EPHEMERAL_TOKEN_URL=

# ── VPS backend ───────────────────────────────────────────────────────────────
# URL of the Jarvis VPS REST API (used for Hermes triggers, card push, etc.)
VPS_BASE_URL=http://localhost:8765
# WebSocket URL for live mobile ↔ VPS channel.
VPS_WS_URL=ws://localhost:8765/ws
# Shared bearer token — must match VPS_BEARER_TOKEN on the server.
VPS_BEARER_TOKEN=
# Unique identifier for this device (UUID, auto-generated if blank).
VPS_DEVICE_ID=

# ── VPS server settings (used by vps/main.py) ─────────────────────────────────
VPS_HOST=0.0.0.0
VPS_PORT=8765
VPS_LOG_LEVEL=info
# Hermes state DB path (auto-detected if Hermes is installed).
HERMES_STATE_DB=/root/.hermes/state.db
ENABLE_HERMES=true
